# ============================================================
# GPT Quant v2 - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------
GPTQ_DATABASE_URL=postgresql+asyncpg://gptquant:gptquant@localhost:5432/gptquant
GPTQ_DATABASE_ECHO=false

# ------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------
GPTQ_REDIS_URL=redis://localhost:6379/0
GPTQ_REDIS_MAX_CONNECTIONS=10

# ------------------------------------------------------------
# API Keys (Required)
# ------------------------------------------------------------
# Polygon.io - Market data
GPTQ_POLYGON_API_KEY=your_polygon_api_key_here

# OpenAI - Sentiment analysis
GPTQ_OPENAI_API_KEY=your_openai_api_key_here
GPTQ_OPENAI_MODEL=gpt-4o-mini
GPTQ_OPENAI_TEMPERATURE=0.1

# Tiingo - News data
GPTQ_TIINGO_API_KEY=your_tiingo_api_key_here

# ------------------------------------------------------------
# Toss/DART lightweight news poller (low-latency path, separate from
# quant-airflow's batch ingestion -- see spike 004)
# ------------------------------------------------------------
GPTQ_KRX_NEWS_DART_API_KEY=your_dart_opendart_api_key_here
GPTQ_KRX_NEWS_TOSS_POLL_INTERVAL_SECONDS=180
GPTQ_KRX_NEWS_DART_POLL_INTERVAL_SECONDS=300
GPTQ_KRX_NEWS_TOSS_FAILURE_THRESHOLD=3
GPTQ_KRX_NEWS_CIRCUIT_RESET_SECONDS=600

# ------------------------------------------------------------
# quant-airflow TimescaleDB (read-only market data source)
# ------------------------------------------------------------
# See quant-airflow/README.md "데이터 읽는 법" for the reference connection.
# gpt-quant-v2 only ever reads from this DB — never writes into it.
GPTQ_QUANT_AIRFLOW_DB_HOST=localhost
GPTQ_QUANT_AIRFLOW_DB_PORT=5432
GPTQ_QUANT_AIRFLOW_DB_DBNAME=kr_quant
GPTQ_QUANT_AIRFLOW_DB_USER=kr_quant
GPTQ_QUANT_AIRFLOW_DB_PASSWORD=your_timescale_password_here

# ------------------------------------------------------------
# Trading Configuration
# ------------------------------------------------------------
# Trading window (Eastern Time)
GPTQ_TRADING_WINDOW_START=09:30
GPTQ_TRADING_WINDOW_END=16:00

# Risk management
GPTQ_MAX_POSITION_SIZE=10000
GPTQ_MIN_RISK_REWARD_RATIO=1.5
GPTQ_MAX_DAILY_LOSS=1000
GPTQ_POSITION_RISK_PERCENT=1.0

# Signal thresholds
GPTQ_MIN_SIGNAL_CONFIDENCE=0.7
GPTQ_MIN_SENTIMENT_SCORE=0.5

# ------------------------------------------------------------
# ML Configuration
# ------------------------------------------------------------
GPTQ_MLFLOW_TRACKING_URI=sqlite:///mlruns.db
GPTQ_MODEL_REGISTRY_PATH=./models

# ------------------------------------------------------------
# Broker Configuration
# ------------------------------------------------------------
# Broker type: paper, alpaca, ibkr
GPTQ_BROKER_TYPE=paper

# Alpaca (if using)
GPTQ_ALPACA_API_KEY=your_alpaca_api_key_here
GPTQ_ALPACA_SECRET_KEY=your_alpaca_secret_key_here
GPTQ_ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------
GPTQ_HOST=0.0.0.0
GPTQ_PORT=8000
GPTQ_WORKERS=4
GPTQ_DEBUG=false

# ------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------
GPTQ_LOG_LEVEL=INFO
GPTQ_LOG_FORMAT=json
GPTQ_LOG_FILE=logs/gptquant.log

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
GPTQ_SECRET_KEY=your-super-secret-key-change-in-production
GPTQ_CORS_ORIGINS=["http://localhost:3000"]
